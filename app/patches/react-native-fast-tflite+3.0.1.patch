 class HybridAssetLoader : HybridAssetLoaderSpec() {
   override fun loadAsset(path: String): Promise<ArrayBuffer> {
     return Promise.async {
-      val bytes = URL(path).readBytes()
+      // A URL (http in debug builds, file or content) is read as before. In a
+      // release build React Native resolves a bundled asset to a bare Android
+      // raw resource name with no scheme, which URL() rejects.
+      val bytes = if (path.contains("://")) URL(path).readBytes() else readRawResource(path)
       return@async ArrayBuffer.copy(bytes)
     }
   }
+
+  private fun readRawResource(name: String): ByteArray {
+    val context = NitroModules.applicationContext
+      ?: throw Error("No application context to load the model resource $name")
+    val id = context.resources.getIdentifier(name, "raw", context.packageName)
+    if (id == 0) {
+      throw Error("Model resource not found in res/raw: $name")
+    }
+    return context.resources.openRawResource(id).use { it.readBytes() }
+  }
 }
